# Written by install.sh from the plugin's template, which keeps the file it replaces as
# <unit>.bak-<YYYY-MM-DD-HHMMSS>. bin/boss-link says at session start when this file is
# out of date. Put a deliberate change in a drop-in, <unit>.d/override.conf, which is left alone.
[Unit]
Description=Weekly measure of where the boss tracks spend time and tokens
Documentation=file://@ROOT@/routines/boss-efficiency.md

[Service]
# @ROOT@ is the stable link routines/claude-boss, not a version directory;
# bin/boss-link moves it on every session start, so a new plugin version needs no re-render;
# a change to this template does, and boss-link says so.
Type=oneshot
ExecStart=@ROOT@/routines/boss-efficiency.sh
Environment=CLAUDE_CONFIG_DIR=@CFG@
# A scan of the transcripts takes minutes at nice 19; it can also wait up to 2 h
# for the transcripts lock, and the body caps the scan at 1 h; 4 h leaves the body room to log. The backstop is for a wedged interpreter.
TimeoutStartSec=4h
Nice=19
# Measured on one real week: the scan holds well under a tenth of this. The cap leaves room for a backfill
# of several weeks and stops a runaway before it swaps the shared laptop.
MemoryMax=1G
