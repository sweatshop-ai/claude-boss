# Written by install.sh from the plugin's template, which keeps the file it replaces as
# <unit>.bak-<YYYY-MM-DD-HHMMSS>. bin/boss-link says at session start when this file is
# out of date. Put a deliberate change in a drop-in, <unit>.d/override.conf, which is left alone.
[Unit]
Description=Post due boss escalation rungs from tracker marker lines
Documentation=file://@ROOT@/routines/boss-ladder.md

[Service]
# @ROOT@ is the stable link routines/claude-boss, not a version directory;
# bin/boss-link moves it on every session start, so a new plugin version needs no re-render;
# a change to this template does, and boss-link says so.
Type=oneshot
ExecStart=@ROOT@/routines/boss-ladder.sh
Environment=CLAUDE_CONFIG_DIR=@CFG@
StandardOutput=append:@CFG@/routines/logs/boss-ladder.log
StandardError=append:@CFG@/routines/logs/boss-ladder.log
# Local file reads plus at most one Slack post per marker. The body caps the
# core at 120 s itself; this is the backstop for a wedged interpreter.
TimeoutStartSec=180
