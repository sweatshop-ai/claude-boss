#!/usr/bin/env bash
# boss-start — launch a /boss session with the settings a boss needs.
#
# Two things a boss cannot set for itself once it is running:
#
#   --model opus           The boss's job is judgment: reading a worker's report
#                          for the defect it does not mention, reviewing a plan,
#                          deciding who gets what. That is the "full model" column
#                          in references/models.md. Opus 5.5, not Fable: Opus 5.5
#                          is cheaper on every price column, cache reads included
#                          (2026-11-15). Workers are on Opus too; see
#                          boss-lifecycle.sh spawn.
#
#   --autocompact 200k     A boss compacts, it does not clear. Its durable state
#                          is on disk by construction (the tracker), so a
#                          compaction costs it little, while a worker holds
#                          probe scripts and half-formed diagnoses in its head
#                          and gets a handoff + restart after every task.
#                          200k sits inside the boss's own 150–250k band
#                          (workers use 150k/250k) and below the 250k
#                          CTX-RESTART line, so a boss never
#                          shows up on its own list as overdue. A session cannot
#                          compact itself on demand (there is no programmatic
#                          /compact) — the threshold is the whole lever, and it
#                          is set here or nowhere.
#
#   --settings (agent teams off)
#                          With CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1, any Agent
#                          call with a `name` starts an agent-teams teammate
#                          inside the boss's process: no pane, no stamp, so
#                          list --mine, the pulse and the workers watch never see
#                          it, and it dies with the boss. A boss never leads
#                          teammates (workers may). A shell `export ...=0` does
#                          not work: the settings.json env wins over the shell.
#                          A --settings payload applies after user settings, so
#                          it does. Verified 2026-10-05: with it, no
#                          ~/.claude/teams/session-* dir appears at startup.
#                          A second --settings REPLACES the first (checked the
#                          same day: two payloads, only the last one's env
#                          survived), so an owner's --settings in the extra
#                          args is refused rather than silently dropping either.
#
#   --remote-control "<track> (boss)"
#                          With a track, the boss is on Remote Control under the
#                          track's name, so the owner can follow it from
#                          claude.ai/code or the phone (Thierry, 2026-11-18).
#                          BOSS_RC_TRACK carries the track into the boss's
#                          Bash calls, and boss-lifecycle.sh puts the concierge
#                          on it as "<track> (concierge)". BOSS_REMOTE_CONTROL=0
#                          turns both off. The tmux window takes the track's name
#                          too, with renaming off so Claude's title does not
#                          replace it.
#
# Global settings would do it too (autoCompactWindow, model), but they would
# apply to every worker as well, and for workers both are wrong.
#
# Usage:
#   boss-start [track] [extra claude args...]
#
# Must run inside tmux: a boss started outside tmux cannot spawn workers.
set -euo pipefail

MODEL="${BOSS_MODEL:-opus}"
AUTOCOMPACT="${BOSS_AUTOCOMPACT:-200k}"
# medium (the owner, 2026-11-15; high from 2026-10-20, xhigh before): output,
# thinking included, was 17-30% of the bill on six measured boss sessions, so
# every step down in effort is a real saving, and Opus 5.5 at medium judges
# well enough for a boss.
EFFORT="${BOSS_EFFORT:-medium}"
# Overload or outage on the primary must not silence the boss (P12: silence
# after a blocker is a bug). The fallback must differ from the primary; the
# switch lasts one turn and Claude Code prints a notice when it happens.
FALLBACK="${BOSS_FALLBACK:-sonnet}"

if [[ -z "${TMUX:-}" ]]; then
  printf 'boss-start: not inside tmux. A boss outside tmux can only adopt, never spawn.\n' >&2
  printf '  Open a tmux pane first, then run boss-start again.\n' >&2
  exit 1
fi

for a in "$@"; do
  if [[ "$a" == --settings || "$a" == --settings=* ]]; then
    printf 'boss-start: --settings is refused here. A second --settings replaces the\n' >&2
    printf '  one that turns agent teams off for the boss. Put what you need in\n' >&2
    printf '  ~/.claude/settings.json, or start claude by hand with one payload that\n' >&2
    printf '  also carries "env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}.\n' >&2
    exit 2
  fi
done

track=""
if [[ $# -gt 0 && "$1" != -* ]]; then track=$1; shift; fi

rc=()
unset BOSS_RC_TRACK
if [[ -n "$track" ]]; then
  tmux rename-window -t "$TMUX_PANE" "$track" || true
  tmux set-option -w -t "$TMUX_PANE" automatic-rename off || true
  tmux set-option -w -t "$TMUX_PANE" allow-rename off || true
  owner_rc=""
  for a in "$@"; do [[ "$a" == --remote-control* ]] && owner_rc=1; done
  if [[ "${BOSS_REMOTE_CONTROL:-1}" != 0 ]]; then
    export BOSS_RC_TRACK=$track
    [[ -n "$owner_rc" ]] || rc=("--remote-control=$track (boss)")
  fi
fi

printf 'boss-start: model=%s effort=%s autocompact=%s fallback=%s%s%s\n' \
  "$MODEL" "$EFFORT" "$AUTOCOMPACT" "$FALLBACK" "${track:+ track=$track}" \
  "${BOSS_RC_TRACK:+ remote-control=on}" >&2
printf '  after it opens, type: /boss%s\n' "${track:+ monitor}" >&2

exec claude --model "$MODEL" --effort "$EFFORT" --autocompact "$AUTOCOMPACT" \
  --fallback-model "$FALLBACK" \
  --settings '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}' "${rc[@]}" "$@"
