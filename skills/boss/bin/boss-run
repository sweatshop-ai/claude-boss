#!/usr/bin/env bash
# boss-run — the one path by which a /boss session may execute a write itself.
#
# A boss that hands every `gh pr comment` to the owner's clipboard is not a boss.
# But a coordinator with a free hand on a shell is the reason the Cardinal Rule
# exists. So: the boss states an intent, a second model reads the intent and the
# command and answers APPROVE or REJECT, and only APPROVE runs.
#
# boss-run runs only what it can see completely. The command is an argument list,
# executed directly: there is no `bash -c`, so nothing in it is expanded, joined or
# redirected after the reviewer has read it (ticket 53b; PR 148 tried to prove a shell
# string harmless instead, and Codex found twelve ways around it in three rounds).
#
# Three gates, in order (after the APPROVE the program is resolved from fixed directories, not PATH):
#   1. argv_gate.py. The command becomes an argument list, or is refused: a single
#      argument must be plain words and quotes; argv[0] must be a bare name on the gate's
#      list of programs (gh, git, cp, mv, mkdir, touch, rm, ls, cat, head, tail, jq, grep,
#      rg, date, systemctl status/show), with gh and git limited to listed subcommands and
#      to options that cannot run a program. A shell, an interpreter or any other program
#      is refused; a boss that needs a script dispatches it to a worker. Nothing runs and
#      no reviewer sees a refused command.
#   2. Hard rules. Pattern matches on that list joined with single spaces. No reviewer
#      can override them and there is no flag to skip them.
#   3. The reviewer (reviewer_chain.py). Codex first, Opus if Codex is missing or
#      silent. If neither answers, nothing runs — a gate that fails open is not a
#      gate.
#
# Usage:
#   boss-run --why "<intent>" [--cwd DIR] [--dry-run] -- <command ...>
#   boss-run --selftest
#
# Everything after `--` is the command. Several arguments are the argument list, as they
# are. A single argument is split into one only when it is fully literal: plain words and
# quotes, with no $ ` \\ ; & | < > ( ) { } * ? [ ! ~, no newline outside quotes, no comment.
# Anything else is refused. A pipe or a redirection stays outside boss-run:
#   boss-run --why "..." -- gh pr view 5 | tail
#
# Exit codes:
#   the command's own   APPROVE, and it ran
#   0                   APPROVE under --dry-run
#   2                   usage
#   3                   REJECTED by the reviewer
#   4                   no reviewer answered
#   5                   refused by argv_gate or by a hard rule
set -uo pipefail

# The hooks read $CLAUDE_CONFIG_DIR/pm; so must every tool that writes there.
PM="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/pm"
LOG="${PM}/boss-run.log"
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROMPT_FILE="${HERE}/../references/boss-run-review.md"
# The fallback reviewer, by the preset name reviewer_chain.py knows; the model id lives there.
FALLBACK_NAME="opus"
# Seconds each reviewer gets, whole numbers. Tests set it short so a hung reviewer is cut off at once.
# The chain gives the fallback twice the Codex budget; the owner may set it outright.
TIMEOUT="${BOSS_RUN_REVIEW_TIMEOUT:-120}"
FALLBACK_TIMEOUT="${BOSS_RUN_REVIEW_FALLBACK_TIMEOUT:-}"

WHY="" ; CWD="$PWD" ; DRY=0 ; CMD="" ; FLAT=""
REVIEWER="none" ; VERDICT="" ; REASON=""

die() { printf 'boss-run: %s\n' "$*" >&2; exit 2; }

usage() {
  sed -n '/^# Usage:/,/^#   5 /p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# ---------------------------------------------------------------- logging ----
log_line() {
  local exit_code=$1
  mkdir -p "$PM" 2>/dev/null || return 0
  jq -nc \
    --arg ts       "$(date -Is)" \
    --arg session  "${CLAUDE_CODE_SESSION_ID:-}" \
    --arg cwd      "$CWD" \
    --arg why      "$WHY" \
    --arg cmd      "$CMD" \
    --arg reviewer "$REVIEWER" \
    --arg verdict  "$VERDICT" \
    --arg reason   "$REASON" \
    --argjson exit "$exit_code" \
    '{ts:$ts,session:$session,cwd:$cwd,why:$why,cmd:$cmd,reviewer:$reviewer,verdict:$verdict,reason:$reason,exit:$exit}' \
    >> "$LOG" 2>/dev/null || true
}

finish() { local rc=$1; log_line "$rc"; exit "$rc"; }

# ------------------------------------------------------------- hard rules ----
# name<TAB>regex. Matched against FLAT: the argument list argv_gate.py accepted, joined with
# single spaces, quotes already gone. Nothing runs through a shell afterwards, so the text
# matched is the text executed.
# Your own off-limits hosts, paths and services are site configuration, not
# code, so they are not in this repository — naming them here would publish the
# map. Add them as `name<TAB>regex` lines in the file below and they are checked
# exactly like the built-in rules:
#
#     echo -e 'gateway VPS\t(198.51.100.7|/opt/our-gateway)' >> "$HARD_RULES_FILE"
#
HARD_RULES_FILE="${BOSS_HARD_RULES:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/boss-hard-rules.tsv}"

hard_rules() {
  [[ -f $HARD_RULES_FILE ]] && cat "$HARD_RULES_FILE"
  cat <<'RULES'
push to main	git[[:space:]]+push[^&|;]*(^|[[:space:]:/])(main|master)([[:space:]]|$)
force push	git[[:space:]]+push[^&|;]*(--force|[[:space:]]-[a-z]*f([[:space:]]|$)|[[:space:]]\+[^[:space:]])
prod deploy	deploy-prod
prod service restart	systemctl[[:space:]]+(restart|stop)
recursive delete of non-regenerable data	rm[[:space:]]+-[^[:space:]]*r[^&|;]*(/Documents|/brain|Projects/[^/ ]*/clients|\.db|recordings|~|/[[:space:]]|/$)
edit of settings.json / CLAUDE.md	(settings\.json|settings\.local\.json|CLAUDE\.md)
DROP TABLE / DATABASE	DROP[[:space:]]+(TABLE|DATABASE)
git reset --hard	git[[:space:]]+reset[^&|;]*--hard
git clean -f	git[[:space:]]+clean[^&|;]*[[:space:]]-[a-z]*f
PR merge outside boss_merge	(^|[^[:alnum:]_.-])gh[[:space:]]([^&|;]*[[:space:]])?pr([[:space:]]+(--repo([[:space:]]+[^[:space:]]*|=[^[:space:]]*)|-R([[:space:]]+[^[:space:]]*|[^[:space:]]+)))*[[:space:]]+merge|(-X|--method)[[:space:]=]*PUT[^&|;]*pulls/[^/[:space:]]+/merge|pulls/[^/[:space:]]+/merge[^&|;]*(-X|--method)[[:space:]=]*PUT|mergePullRequest|enablePullRequestAutoMerge
RULES
}

check_hard_rules() {
  local name re
  shopt -s nocasematch
  while IFS=$'\t' read -r name re; do
    [[ -n "$name" ]] || continue
    if [[ "$FLAT" =~ $re ]]; then
      shopt -u nocasematch
      REVIEWER="hard-rule" ; VERDICT="REFUSED"
      REASON="hard rule: ${name} (matched /${re}/)"
      printf 'boss-run: REFUSED by hard rule — %s\n' "$name" >&2
      printf '  pattern: %s\n' "$re" >&2
      printf '  command: %s\n' "$CMD" >&2
      printf '  No reviewer can override this. Take it to the owner.\n' >&2
      return 1
    fi
  done < <(hard_rules)
  shopt -u nocasematch
  return 0
}

# ------------------------------------------------------------------ gate ----
# argv_gate.py answers one JSON object: exit 0 {ok:true, argv, flat, display}, exit 1
# {ok:false, rule, detail}. Anything else (a crash, a signal, no python3, output that is not
# one whole answer) is no answer, and a gate that cannot look refuses.
# Two calls: the first reads the text and the program's name and runs nothing; the second comes
# after the reviewer's APPROVE, right before the command runs: it resolves argv[0] from the gate's
# fixed directories (PATH is not used) and, for gh, reads the aliases gh reports. Nothing is
# executed for a command that is refused or rejected, and what runs is the absolute path it found.
ARGV=() ; ARGS=() ; EXEC=()
run_gate() {
  local out rc ok rule detail mode=("$@")
  out=$(python3 -I "${HERE}/../argv_gate.py" "${mode[@]}" --cwd "$CWD" --config-dir "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" -- "${ARGS[@]}" 2>/dev/null); rc=$?
  ok=$(jq -r 'select(type == "object") | .ok' <<<"$out" 2>/dev/null) || ok=""
  if [[ $rc -eq 0 && $ok == true ]] && jq -e '(.argv | type == "array" and length > 0 and all(type == "string"))
        and (.flat | type == "string") and (.display | type == "string")' <<<"$out" >/dev/null 2>&1; then
    if [[ ${mode[0]:-} == --resolve ]]; then
      mapfile -d '' -t EXEC < <(jq -j '.exec[] + "\u0000"' <<<"$out")
      [[ ${#EXEC[@]} -gt 0 && ${EXEC[0]} == /* ]] || { rc=2; ok=""; }
    else
      mapfile -d '' -t ARGV < <(jq -j '.argv[] + "\u0000"' <<<"$out")
      FLAT=$(jq -r '.flat' <<<"$out")
      CMD=$(jq -r '.display' <<<"$out")
    fi
    [[ $rc -eq 2 ]] || return 0
  fi
  if [[ $rc -eq 1 && $ok == false ]]; then
    rule=$(jq -r '.rule' <<<"$out"); detail=$(jq -r '.detail' <<<"$out")
  else
    rule="the argument gate did not answer"; detail="argv_gate.py exited $rc"
  fi
  REVIEWER="hard-rule" ; VERDICT="REFUSED" ; REASON="argv gate: ${rule} (${detail})"
  printf 'boss-run: REFUSED by the argument gate — %s\n' "$rule" >&2
  printf '  seen: %s\n' "$detail" >&2
  printf '  command: %s\n' "$CMD" >&2
  printf '  boss-run runs only a literal argument list. Nothing was run; no reviewer saw it. Take it to the owner.\n' >&2
  return 1
}

# ---------------------------------------------------------------- reviewer ----
# Which reviewer answers -- Codex, then Opus, otherwise nobody -- is decided by
# reviewer_chain.py. boss-run renders the prompt, calls it, and acts on its answer
# only when the answer is whole: exit 0, one JSON object, a reviewer's name, and
# APPROVE or REJECT. A crash, garbage, a signal or a missing python3 is "no
# reviewer answered", and nothing runs.
CHAIN="${HERE}/../reviewer_chain.py"
PROMPT_TMP=""
trap '[[ -z "$PROMPT_TMP" ]] || rm -f -- "$PROMPT_TMP"' EXIT

# Fills {{WHY}}, {{CWD}} and {{CMD}} in one pass, copying the values in as they
# are. (${t//pat/$v} treats an `&` in $v as "the matched text", so `a && b` once
# reached the reviewer as `a {{CMD}}{{CMD}} b`.)
render_prompt() {
  local rest out=""
  [[ -f "$PROMPT_FILE" ]] || die "missing reviewer prompt: $PROMPT_FILE"
  rest="$(cat "$PROMPT_FILE")"
  while [[ $rest == *'{{'* ]]; do
    out+=${rest%%'{{'*}
    rest=${rest#*'{{'}
    case $rest in
      'WHY}}'*) out+=$WHY; rest=${rest#'WHY}}'} ;;
      'CWD}}'*) out+=$CWD; rest=${rest#'CWD}}'} ;;
      'CMD}}'*) out+=$CMD; rest=${rest#'CMD}}'} ;;
      *)        out+='{{' ;;
    esac
  done
  printf '%s' "$out$rest"
}

# Takes the chain's JSON; sets REVIEWER, VERDICT and REASON from it. Returns 1
# unless it is exactly one JSON value that is a whole Result: a reviewer boss-run
# asked for (codex or the fallback), a verdict that is APPROVE or REJECT with its
# reason, the raw output, and an attempt by that reviewer that answered. (Slurped:
# `jq -e` alone judges only the last value, so a refusal followed by an approval
# would have passed. The real chain never breaks these invariants; this gate does
# not rely on that.)
adopt_answer() {
  local json=$1
  jq -es --arg fb "$FALLBACK_NAME" 'length == 1 and (.[0] | . as $r
          | ($r.reviewer | IN("codex", $fb))
          and ($r.output | type == "string")
          and ($r.parsed.word | IN("APPROVE", "REJECT"))
          and ($r.parsed.reason | type == "string")
          and ($r.attempts | type == "array"
               and any(.[]; .reviewer == $r.reviewer and .reason == "answered")))' \
    <<<"$json" >/dev/null 2>&1 || return 1
  REVIEWER=$(jq -sr '.[0].reviewer' <<<"$json")
  VERDICT=$(jq -sr '.[0].parsed.word' <<<"$json")
  REASON=$(jq -sr '.[0].parsed.reason' <<<"$json")
}

run_reviewer() {
  local json rc
  PROMPT_TMP=$(mktemp) || { PROMPT_TMP=""; return 1; }
  printf '%s' "$1" >"$PROMPT_TMP" || return 1
  json=$(python3 "$CHAIN" --prompt-file "$PROMPT_TMP" \
           --words APPROVE,REJECT --match prefix --effort medium \
           --codex-timeout "$TIMEOUT" \
           --fallback "$FALLBACK_NAME" ${FALLBACK_TIMEOUT:+--fallback-timeout "$FALLBACK_TIMEOUT"} \
           </dev/null 2>/dev/null); rc=$?
  rm -f -- "$PROMPT_TMP"; PROMPT_TMP=""
  [[ $rc -eq 0 ]] || return 1
  adopt_answer "$json"
}

# ---------------------------------------------------------------- selftest ----
# Five cases. The happy path alone proves nothing — the refusals are the control,
# so a run that reports ok on case 2 and nothing else is a failure.
selftest() {
  local self="${BASH_SOURCE[0]}" fails=0 rc out

  printf '1. hard rule — `git push origin main` must be refused (exit 5)\n'
  out=$("$self" --why "push the release" --dry-run -- git push origin main 2>&1); rc=$?
  if [[ $rc -eq 5 ]]; then printf '   ok (exit 5)\n'
  else printf '   FAIL: exit %s\n%s\n' "$rc" "$(sed 's/^/   | /' <<<"$out")"; fails=1; fi

  printf '2. reviewer approves a worktree removal matching its intent (exit 0)\n'
  out=$("$self" --why "remove the git worktree of a PR build no longer needed" --dry-run \
        -- git worktree remove /tmp/boss-selftest-pr36-worktree 2>&1); rc=$?
  if [[ $rc -eq 0 ]]; then printf '   ok (exit 0, %s)\n' "$(grep -o 'reviewer: [a-z-]*' <<<"$out" | head -1)"
  else printf '   FAIL: exit %s\n%s\n' "$rc" "$(sed 's/^/   | /' <<<"$out")"; fails=1; fi

  printf '3. reviewer rejects destruction dressed as housekeeping (exit 3 or 5)\n'
  out=$("$self" --why "free disk space" --dry-run \
        -- rm -r "$HOME/Projects/acme/clients/old" 2>&1); rc=$?
  if [[ $rc -eq 3 || $rc -eq 5 ]]; then printf '   ok (exit %s)\n' "$rc"
  else printf '   FAIL: exit %s\n%s\n' "$rc" "$(sed 's/^/   | /' <<<"$out")"; fails=1; fi

  printf '4. a single argument that is not plain words and quotes is refused by the gate (exit 5)\n'
  out=$("$self" --why "list the files" --dry-run -- 'ls | head' 2>&1); rc=$?
  if [[ $rc -eq 5 && $out == *"not fully literal"* ]]; then printf '   ok (exit 5)\n'
  else printf '   FAIL: exit %s\n%s\n' "$rc" "$(sed 's/^/   | /' <<<"$out")"; fails=1; fi

  printf '5. a program off the list (a shell) is refused by name (exit 5)\n'
  out=$("$self" --why "say hi" --dry-run -- bash -c 'echo hi' 2>&1); rc=$?
  if [[ $rc -eq 5 && $out == *"not on boss-run's list"* ]]; then printf '   ok (exit 5)\n'
  else printf '   FAIL: exit %s\n%s\n' "$rc" "$(sed 's/^/   | /' <<<"$out")"; fails=1; fi

  if [[ $fails -eq 0 ]]; then printf 'selftest: all ok\n'; exit 0; fi
  printf 'selftest: FAILED\n'; exit 1
}

# ------------------------------------------------------------------- main ----
[[ $# -gt 0 ]] || { usage >&2; exit 2; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --selftest) selftest ;;
    --why)      WHY=${2:-}; [[ -n "$WHY" ]] || die "--why needs an intent"; shift 2 ;;
    --cwd)      CWD=${2:-}; [[ -n "$CWD" ]] || die "--cwd needs a directory"; shift 2 ;;
    --dry-run)  DRY=1; shift ;;
    -h|--help)  usage; exit 0 ;;
    --)         shift; break ;;
    *)          die "unknown argument: $1 (command goes after --)" ;;
  esac
done

[[ -n "$WHY" ]] || die "--why \"<intent>\" is required: the reviewer judges the command against it"
[[ $# -gt 0 ]] || die "no command — put it after --"
[[ -d "$CWD" ]] || die "no such directory: $CWD"
CWD=$(cd -- "$CWD" && pwd)

# What the owner reads if the gate refuses: the text as typed. Once the gate accepts it is the
# argument list quoted back, which is what the reviewer reads and what runs.
if [[ $# -eq 1 ]]; then CMD=$1; else CMD=$(printf '%q ' "$@"); CMD=${CMD% }; fi
FLAT="$*"

ARGS=("$@")
if [[ $# -eq 1 ]]; then run_gate --single || finish 5; else run_gate || finish 5; fi
check_hard_rules || finish 5

# The command is the template's last text, and $(...) strips trailing newlines: the reviewer
# must see the bytes that will run, so a sentinel keeps them.
PROMPT=$(render_prompt && printf .) || finish 2
PROMPT=${PROMPT%.}
if ! run_reviewer "$PROMPT"; then
  REVIEWER="none"; VERDICT=""; REASON="no reviewer answered"
  printf 'boss-run: no reviewer answered (codex and %s both silent or absent).\n' "$FALLBACK_NAME" >&2
  printf '  Nothing was run. Retry, or hand the command to the owner.\n' >&2
  finish 4
fi

if [[ "$VERDICT" == "REJECT" ]]; then
  printf 'boss-run: REJECTED by %s — %s\n' "$REVIEWER" "$REASON" >&2
  printf '  command: %s\n' "$CMD" >&2
  printf '  A REJECT is final for this command. Escalate it to the owner with the reason.\n' >&2
  finish 3
fi

# The probe runs gh or git, so it waits for the APPROVE: a REJECT or a dead reviewer never
# starts the program, and the answer is as fresh as it can be when the command runs.
APPROVED_BY=$REVIEWER ; APPROVED_VERDICT=$VERDICT ; APPROVED_REASON=$REASON
ARGS=("${ARGV[@]}")
run_gate --resolve || finish 5
REVIEWER=$APPROVED_BY ; VERDICT=$APPROVED_VERDICT ; REASON=$APPROVED_REASON
printf 'boss-run: APPROVE (reviewer: %s) — %s\n' "$REVIEWER" "$REASON"
if [[ $DRY -eq 1 ]]; then
  printf '  --dry-run: not executed.\n'
  finish 0
fi

# No shell: the list the reviewer read is the list that runs.
( cd "$CWD" && exec -- "${EXEC[@]}" )
rc=$?
printf 'boss-run: command exited %s\n' "$rc"
log_line "$rc"
exit "$rc"
