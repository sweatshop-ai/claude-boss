#!/usr/bin/env bash
# Keep the stable path to this plugin pointing at wherever it lives now.
#
#   $CLAUDE_CONFIG_DIR/routines/claude-boss -> <plugin root>
#
# The three systemd units run the ladder, the watchdog and the efficiency
# measure through that link, so they survive a plugin upgrade: a marketplace
# install lands each version in a new cache directory
# (plugins/cache/<marketplace>/claude-boss/<version>/), and
# a unit written against one version dies with it. Measured 2026-10-23: both
# timers failed on every tick for five days after the path moved.
#
# Runs as a SessionStart hook with CLAUDE_PLUGIN_ROOT set, and from install.sh
# with the root as its one argument. Silent when the link is already right;
# one line on stdout when it (re)links. It never moves the link to a lower
# version than the one it points at: every session runs this hook from its own
# version, and on 2026-11-01 a boss started on 0.19.0 compacted and dragged the
# link back from 0.19.1, so the timers ran the old rules. It says "kept" then.
# A missing or dangling link, or either side without a version, is always set,
# and so is a root passed as the argument: install.sh means it, rollback included. A real file or directory at the link
# path is left alone, with a line on stderr, because that is somebody's data.
#
# It also compares each installed systemd unit with the template of the version the
# link points at (MemoryMax reached fresh installs only, because install.sh copies the
# units once) and, when one differs, prints one line saying which and that `install.sh`
# brings it up to date. It writes nothing: a unit may hold a hand edit, and the owner's
# explicit `install.sh` is the one place that replaces it (keeping a dated copy). It also names a
# template with no installed unit (a timer added since install.sh last ran), but only when another boss
# unit is installed: a machine that never ran install.sh hears nothing. The
# comparison reads @ROOT@ and @CFG@ from the installed unit's own lines (the Environment=
# CLAUDE_CONFIG_DIR line, else the log path), so a session
# under another CLAUDE_CONFIG_DIR does not make it noisy. It never fails a session start.
set -euo pipefail

explicit="${1:-}"
root="${1:-${CLAUDE_PLUGIN_ROOT:-}}"
if [[ -z $root ]]; then
  root="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
fi
root="${root%/}"
[[ -f $root/routines/boss-ladder.sh ]] || { echo "boss-link: $root is not a claude-boss checkout" >&2; exit 1; }

cfg="${CLAUDE_CONFIG_DIR:-}"           # an empty value means unset (see boss_store.py)
[[ -n $cfg ]] || cfg="$HOME/.claude"
link="$cfg/routines/claude-boss"

check_units() {
  local units="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user" tdir u tpl got r c differ= absent= any=
  tdir="$(readlink -f -- "$link")/systemd"
  [[ -d $units && -d $tdir ]] || return 0
  for u in boss-ladder.service boss-ladder.timer boss-workers-watch.service \
           boss-workers-watch.timer boss-efficiency.service boss-efficiency.timer; do
    [[ -f $tdir/$u.in ]] || continue
    if [[ ! -f $units/$u ]]; then absent="$absent $u"; continue; fi
    any=1
    tpl="$tdir/$u.in"
    r="$(sed -n 's|^ExecStart=\(.*\)/routines/[^/]*$|\1|p' "$units/$u" | head -n1)"
    c="$(sed -n -e 's|^Environment=CLAUDE_CONFIG_DIR=\(.*\)$|\1|p' -e 's|^StandardOutput=append:\(.*\)/routines/logs/[^/]*$|\1|p' "$units/$u" | head -n1)"
    got="$(sed -e "s|@ROOT@|${r:-$link}|g" -e "s|@CFG@|${c:-$cfg}|g" "$tpl"; echo x)"
    [[ "$(cat -- "$units/$u"; echo x)" == "$got" ]] || differ="$differ $u"
  done
  if [[ -n $differ ]]; then
    echo "boss-link: installed unit(s) differ from this version's templates:$differ; run $(readlink -f -- "$link")/install.sh to bring them up to date (a replaced unit is kept as .bak-<date-time>)"
  fi
  # A unit this version added reaches only those who rerun install.sh. A machine with no boss unit
  # at all never ran it, so it hears nothing.
  if [[ -n $any && -n $absent ]]; then
    echo "boss-link: this version has unit(s) with no installed unit:$absent; run $(readlink -f -- "$link")/install.sh to add them"
  fi
  return 0
}

version_of() {   # the plugin's own version, empty when it has none
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1/.claude-plugin/plugin.json" 2>/dev/null | head -n1 || true
}

if [[ -L $link ]]; then
  current="$(readlink -- "$link")"
  if [[ $current == "$root" ]]; then check_units || true; exit 0; fi
  if [[ -z $explicit && -e $link ]]; then
    have="$(version_of "$(readlink -f -- "$link")")"
    want="$(version_of "$root")"
    if [[ -n $have && -n $want && $have != "$want" \
          && $(printf '%s\n%s\n' "$have" "$want" | sort -V | tail -n1) == "$have" ]]; then
      echo "boss-link: kept $link -> $current ($have is newer than $want)"
      check_units || true
      exit 0
    fi
  fi
elif [[ -e $link ]]; then
  echo "boss-link: $link exists and is not a symlink; left alone" >&2
  exit 1
fi

mkdir -p "$cfg/routines"
ln -sfn -- "$root" "$link"
echo "boss-link: $link -> $root"
check_units || true
